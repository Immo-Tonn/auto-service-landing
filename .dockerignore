# Зависимости — Docker установит их сам внутри образа
node_modules

# Артефакты предыдущих сборок — Docker соберёт заново
.next
out
build

# Git-история не нужна внутри контейнера
.git
.gitignore

# Файлы окружения — секреты передаются отдельно, не запекаются в образ
.env
.env.*

# Документация и конфиги для разработки
*.md
.eslintrc*

# Системные файлы
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
