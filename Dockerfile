# =============================================================================
# СТАДИЯ 1: "dev" — среда для разработки
# =============================================================================
# node:22-alpine — Node.js 22 на минималистичном Alpine Linux.
# Версия 22 — актуальный LTS (Long-Term Support), получает обновления безопасности.
FROM node:22-alpine AS dev

# libc6-compat — библиотека совместимости.
# Alpine использует musl libc вместо стандартной glibc.
# Некоторые npm-пакеты скомпилированы под glibc и без этого пакета падают с ошибкой.
RUN apk add --no-cache libc6-compat

WORKDIR /app

# Копируем только манифесты зависимостей — не весь проект.
# Смысл: Docker кэширует каждую команду как отдельный "слой".
# Если package.json не менялся — Docker не будет повторно запускать npm ci,
# а возьмёт результат из кэша. Сборка становится значительно быстрее.
COPY package.json package-lock.json ./

# npm ci (clean install) — строгая установка строго по package-lock.json.
# В отличие от npm install, не обновляет версии пакетов случайно.
RUN npm ci

# Исходный код НЕ копируем — он будет смонтирован снаружи через volume в docker-compose.
# Это и есть механизм hot reload: ты меняешь файл на своём компьютере,
# изменение мгновенно появляется внутри контейнера.

EXPOSE 3000

CMD ["npm", "run", "dev"]


# =============================================================================
# СТАДИЯ 2: "builder" — сборка продакшн-бандла
# =============================================================================
FROM node:22-alpine AS builder

RUN apk add --no-cache libc6-compat

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

# Здесь уже копируем весь исходный код — нам нужно его собрать
COPY . .

# Отключаем отправку анонимной статистики в Vercel во время сборки
ENV NEXT_TELEMETRY_DISABLED=1

# Запускаем сборку. Благодаря output: 'standalone' в next.config.ts
# Next.js создаст папку .next/standalone — компактный автономный сервер
RUN npm run build


# =============================================================================
# СТАДИЯ 3: "prod" — финальный минимальный образ для продакшна
# =============================================================================
# Начинаем с чистого образа — не тащим сюда исходный код и node_modules.
# Финальный образ содержит только собранное приложение (~150 МБ вместо ~1 ГБ).
FROM node:22-alpine AS prod

WORKDIR /app

# production — сообщает React и Next.js работать в режиме продакшна:
# отключает предупреждения разработчика, включает оптимизации производительности
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Создаём отдельную группу и пользователя без прав администратора (non-root).
# Почему это важно: если злоумышленник найдёт уязвимость в приложении и
# получит доступ к контейнеру — он окажется обычным пользователем без прав,
# а не root'ом с полным контролем над системой.
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Копируем статические файлы из папки /public (картинки, иконки, robots.txt и т.д.)
# --from=builder означает: взять из стадии builder, а не с хоста
COPY --from=builder /app/public ./public

# Копируем собранный standalone-сервер.
# --chown=nextjs:nodejs — назначаем владельцем нашего непривилегированного пользователя,
# иначе он не сможет читать файлы, созданные от root во время сборки.
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./

# Копируем статические ассеты Next.js (JS/CSS бандлы, шрифты) отдельно.
# В standalone они не включены автоматически — нужно скопировать явно.
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

# Переключаемся на непривилегированного пользователя — все следующие команды
# (включая CMD) будут выполняться от его имени
USER nextjs

EXPOSE 3000

# 0.0.0.0 означает "слушать на всех сетевых интерфейсах".
# Без этого сервер слушал бы только на localhost внутри контейнера
# и был бы недоступен снаружи — даже через маппинг портов.
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# server.js — точка входа, которую генерирует Next.js в standalone-режиме.
# Это лёгкий Node.js HTTP-сервер, не требующий ничего лишнего.
CMD ["node", "server.js"]
